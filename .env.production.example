# Plantilla de .env para PRODUCCIÓN (VPS + Docker).
# Copiala a ".env" en el server y completá los valores marcados.
# NO se incluye en la imagen: el .env real vive solo en el VPS.

APP_NAME="ATALAYA"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # generar con: docker compose ... exec app php artisan key:generate --show
APP_URL=https://TU-DOMINIO     # ej. https://seminario.tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# Hora argentina (ver docs/zona-horaria.md). Es el default de config/app.php.
APP_TIMEZONE=America/Argentina/Cordoba

# --- Base de datos (Postgres dentro de Docker) ---
# DB_HOST DEBE ser "db": es el nombre del servicio en docker-compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=seminario_integrador
DB_USERNAME=seminario
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_FUERTE

# --- Sesión / cache / colas (todo en la DB, sin Redis) ---
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true     # cookies solo por HTTPS
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Logs ---
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Notificaciones (config/notificaciones.php) ---
# telegram (Bot API, recomendado) | whatsapp (Cloud API de Meta) | log (no envía nada).
# Guía del bot y los chat_id: docs/deploy.md.
NOTIFICADOR_CANAL=telegram
TELEGRAM_BOT_TOKEN=            # de @BotFather; uno propio de prod, nunca el de desarrollo
NOTIFICADOR_SIMULAR_FALLO=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Reporte de turno en PDF/A (config/reportes.php) ---
# Ghostscript viene en la imagen; dejar los defaults salvo que haga falta.
PDFA_HABILITADO=true
# GHOSTSCRIPT_BIN=gs
# PDFA_PERFIL_ICC=

# --- Mail (recuperación de contraseña) — completar con tu proveedor ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Vacío con el puerto 587 (STARTTLS); "smtps" con el 465. (MAIL_ENCRYPTION ya no se usa.)
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@TU-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
